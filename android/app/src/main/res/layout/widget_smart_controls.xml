<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/widget_smart_controls_background">

    <Button
        android:id="@+id/widget_light_on"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="5dp"
        android:background="@drawable/widget_light_on_background"
        android:text="LIGHT ON"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <Button
        android:id="@+id/widget_light_off"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="5dp"
        android:background="@drawable/widget_light_off_background"
        android:text="LIGHT OFF"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
